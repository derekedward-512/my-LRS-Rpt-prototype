{
  "name": "lrs-rpt-design-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:docs": "npm --prefix docs-site start",
    "build": "npm run build:app && npm run build:docs",
    "build:app": "tsc --noEmit && vite build",
    "build:docs": "npm --prefix docs-site run build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "start": "tsx server/index.ts",
    "postinstall": "npm --prefix docs-site ci"
  },
  "dependencies": {
    "@trimble-oss/moduswebcomponents-react": "1.16.0-react19",
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  }
}
